# Solo para el proceso backend. No subir el archivo .env real a Git.
APP_ENV=production
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST_PRIVADO:5432/stockgo
API_PUBLIC_URL=https://api.tu-dominio.example
ALLOWED_ORIGINS=https://app.tu-dominio.example
PROVISIONING_KEY=CAMBIAR_POR_UN_SECRETO_LARGO_Y_ALEATORIO
DB_SSLMODE=require
DB_SSLROOTCERT=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
PORT=8081
WEB_CONCURRENCY=1
FORWARDED_ALLOW_IPS=*
