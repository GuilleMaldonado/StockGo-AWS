# Copia este archivo como .env. Nunca subas .env a GitHub.
APP_ENV=production
# PostgreSQL real, nunca la URL de una consola web. Usa conexión directa para LISTEN/NOTIFY.
DATABASE_URL=postgresql+psycopg://USUARIO:CONTRASENA@HOST:5432/BASE
# URL HTTPS pública que abrirán el navegador y el APK, sin barra final.
PUBLIC_API_URL=https://TU-SERVICIO.onrender.com
# Genera una clave aleatoria de 32 caracteres o más para crear negocios.
PROVISIONING_KEY=CAMBIAR_POR_UNA_CLAVE_ALEATORIA_LARGA
# Orígenes exactos, separados por coma; no incluyas comodines.
ALLOWED_ORIGINS=https://TU-SERVICIO.onrender.com
DB_SSLMODE=verify-full
# Vacío usa certificados públicos del sistema Python. Para RDS indica el archivo CA de AWS.
DB_SSLROOTCERT=
DB_POOL_SIZE=3
DB_MAX_OVERFLOW=2
PORT=8081
WEB_CONCURRENCY=1
POSTGRES_PASSWORD=CAMBIAR_POR_UNA_CLAVE_LOCAL_PARA_DOCKER
# En contenedor detrás de proxy confiable. No exponer directamente ese puerto a Internet.
FORWARDED_ALLOW_IPS=127.0.0.1
