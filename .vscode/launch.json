{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "StockGo - Servidor Python",
      "type": "debugpy",
      "request": "launch",
      "program": "${workspaceFolder}/servidor_python/iniciar.py",
      "cwd": "${workspaceFolder}/servidor_python",
      "console": "internalConsole",
      "justMyCode": true
    },
    {
      "name": "StockGo - Chrome",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "chrome",
      "flutterMode": "debug",
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=8080"
      ]
    },
    {
      "name": "StockGo - Edge",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "edge",
      "flutterMode": "debug",
      "toolArgs": [
        "--web-hostname=localhost",
        "--web-port=8080"
      ]
    },
    {
      "name": "StockGo - iOS seleccionado (Android Flutter histórico)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug"
    },
    {
      "name": "StockGo - Windows (servidor desde la app)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "windows",
      "flutterMode": "debug"
    },
    {
      "name": "StockGo - Android Flutter histórico en mi PC",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "deviceId": "emulator-5554",
      "flutterMode": "debug",
      "preLaunchTask": "Iniciar emulador StockGo"
    }
  ]
}
