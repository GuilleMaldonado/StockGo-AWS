{
  "version": "2.0.0",
  "tasks": [
    {
      "label": "StockGo: servidor Python (panel gráfico)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/iniciar_servidor_python.ps1"],
      "problemMatcher": [],
      "presentation": {"reveal": "never", "echo": false}
    },
    {
      "label": "StockGo: compilar APK Kotlin",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/compilar_android_kotlin.ps1"],
      "problemMatcher": []
    },
    {
      "label": "StockGo: ejecutar Android Kotlin (dispositivo conectado)",
      "type": "process",
      "command": "powershell.exe",
      "args": ["-NoProfile", "-ExecutionPolicy", "Bypass", "-File", "${workspaceFolder}/scripts/ejecutar_android_kotlin.ps1"],
      "problemMatcher": []
    },
    {
      "label": "StockGo: preparar dependencias",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/preparar.ps1"
      ],
      "problemMatcher": []
    },
    {
      "label": "StockGo: ejecutar Chrome",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/ejecutar.ps1",
        "-Dispositivo",
        "chrome"
      ],
      "problemMatcher": []
    },
    {
      "label": "StockGo: ejecutar Edge",
      "type": "process",
      "command": "powershell.exe",
      "args": [
        "-NoProfile",
        "-File",
        "${workspaceFolder}/scripts/ejecutar.ps1",
        "-Dispositivo",
        "edge"
      ],
      "problemMatcher": []
    },
    {
      "label": "Iniciar emulador StockGo",
      "type": "process",
      "command": "powershell",
      "args": [
        "-NoProfile",
        "-ExecutionPolicy",
        "Bypass",
        "-File",
        "${workspaceFolder}/scripts/iniciar_emulador.ps1"
      ],
      "problemMatcher": [],
      "presentation": {
        "echo": false,
        "reveal": "never",
        "panel": "dedicated"
      }
    }
  ]
}
